  "queries": [
    {
      "id": 0,
      "name": "all alerts",
      "object_type": "query",
      "conditions": {
        "conditions": [
          {
            "conditions": [
              {
                "field": "event_score",
                "op": ">",
                "type": "number",
                "value": [
                  0
                ]
              }
            ],
            "modifier": "and"
          }
        ],
        "modifier": "or"
      },
      "metadata": {
        "query": "{\"must\": [{\"range\": {\"event_score\": {\"gt\": 0}}}]}",
        "lookups": []
      }
    },
    {
      "id": 1,
      "name": "open alerts",
      "object_type": "query",
      "conditions": {
        "conditions": [
          {
            "conditions": [
              {
                "caseSensitive": false,
                "field": "event_status",
                "op": "==",
                "type": "string",
                "value": [
                  "New",
                  "In Progress"
                ]
              }
            ],
            "modifier": "and"
          }
        ],
        "modifier": "or"
      },
      "metadata": {
        "query": "{\"must\": [{\"bool\": {\"minimum_should_match\": 1, \"should\": [{\"term\": {\"event_status.keyword\": {\"case_insensitive\": \"true\", \"value\": \"New\"}}}, {\"term\": {\"event_status.keyword\": {\"case_insensitive\": \"true\", \"value\": \"In Progress\"}}}]}}]}",
        "lookups": []
      }
    },
    {
      "id": 2,
      "name": "critical alerts",
      "object_type": "query",
      "conditions": {
        "conditions": [
          {
            "conditions": [
              {
                "field": "event_score",
                "op": ">",
                "type": "number",
                "value": [
                  74
                ]
